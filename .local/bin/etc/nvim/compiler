#!/usr/bin/env sh

# This script will compile or run another finishing operation on a document. I
# have this script run via vim.
# Compiles .tex. groff (.mom, .ms), .rmd, .md.  Opens .sent files as sent
# presentations.  Runs scripts based on extention or shebang
# by lukesmithxyz, checkout github.com/lukesmithxyz/voidrice

usage() {
    printf 'Usage: %s [--clear] FILE\n' "${0##*/}"
}

clear_tex=0
input_file=""
while [ "$#" -gt 0 ]; do
    case "$1" in
        --clear) clear_tex=1 ;;
        --)
            shift
            [ "$#" -eq 1 ] && [ -z "$input_file" ] || { usage >&2; exit 2; }
            input_file=$1
            break
            ;;
        -*) usage >&2; exit 2 ;;
        *)
            [ -z "$input_file" ] || { usage >&2; exit 2; }
            input_file=$1
            ;;
    esac
    shift
done
[ -n "$input_file" ] || { usage >&2; exit 2; }

file=$(readlink -f -- "$input_file") || exit 1
dir=$(dirname "$file")
base="${file%.*}"
basenodir="${input_file%.*}"
vipercmd="carbon" #"silicon"

cd "$dir" || exit

has_python_version() {
    dir="$PWD"
    while [ "$dir" != "/" ]; do
        if [ -f "$dir/.python-version" ] || [ -f "$dir/pyproject.toml" ]; then
            return 0
        fi
        dir=$(dirname "$dir")
    done
    return 1
}

textype() {
    # latexmk selects BibTeX or Biber from the generated build files, including
    # bibliography declarations in input files, and resolves cross-references.
    if ! command -v latexmk >/dev/null 2>&1; then
        printf '%s\n' 'compiler: latexmk is required for automatic LaTeX and bibliography compilation.' >&2
        return 127
    fi

    tex_engine="-pdf"
    # Detect XeLaTeX from the first 15 lines. Supported forms include:
    #   % !TeX program = xelatex
    #   % xelatex
    # and packages which require or commonly imply XeLaTeX.
    if sed -n '1,15p' "$file" | grep -Eiq \
        '(^%+[[:space:]]*!tex[[:space:]]+program[[:space:]]*=[[:space:]]*xelatex)|(^%+[[:space:]]*xelatex[[:space:]]*$)|(\\usepackage[^}]*\{(fontspec|unicode-math|mathspec)\})'; then
        tex_engine="-xelatex"
    fi
    if sed -n '1,15p' "$file" | grep -Eiq \
        '(^%+[[:space:]]*!tex[[:space:]]+program[[:space:]]*=[[:space:]]*lualatex)|(^%+[[:space:]]*lualatex[[:space:]]*$)'; then
        tex_engine="-lualatex"
    fi

    # Run in the document directory so resources/lib.bib and other relative
    # paths keep working. Prefix the filename to handle names beginning with '-'.
    tex_input="./$(basename "$file")"
    tex_job=$(basename "$base")

    run_latexmk() {
        # Preserve the original script's shell-escape setting for pdfLaTeX.
        if [ "$tex_engine" = "-pdf" ]; then
            latexmk "$tex_engine" -shell-escape -interaction=nonstopmode \
                -halt-on-error -file-line-error "$tex_input"
        else
            latexmk "$tex_engine" -interaction=nonstopmode \
                -halt-on-error -file-line-error "$tex_input"
        fi
    }

    run_latexmk || return 1

    if sed 's/%.*//' "$file" | grep -iq '\\makeglossaries'; then
        makeglossaries "$tex_job" || return 1
        run_latexmk || return 1
    fi

    return 0
}

case "$file" in
*\.[0-9]) refer -PS -e "$file" | groff -mandoc -T pdf >"$base".pdf ;;
*\.bash) bash "$file" ;;
*\.go) go run "$file" ;;
*\.lua) lua "$file" ;;
*\.md) pandoc "$file" --pdf-engine=xelatex -o "$base".pdf ;;
*\.mom) refer -PS -e "$file" | groff -mom -kept -T pdf >"$base".pdf ;;
*\.ms) refer -PS -e "$file" | groff -me -ms -kept -T pdf >"$base".pdf ;;
*\.py)
    if has_python_version; then
        uv run python "$file"
    else
        python3 "$file"
    fi
    ;;
*\.rmd) echo "require(rmarkdown); render('$file')" | R -q --vanilla ;;
*\.sent) setsid sent "$file" 2>/dev/null & ;;
*config.h) sudo make install ;;
*\.c) if [ -f Makefile ]; then make run; else cc "$file" -o "$base" && "$base"; fi ;;
*\.java) java "$file" ;;
*\.js) node "$file" ;;
*\.m) octave -qW "$file" ;;
*\.nim) nim c -r -d:noColors "$file" ;;
*\.r | *\.R) Rscript "$file" ;;
*\.rs) (cd "$dir" && cargo locate-project >/dev/null 2>&1) &&
    (cd "$(dirname "$(cd "$dir" && cargo locate-project --message-format plain)")" && cargo run) ||
    (rustc "$file" && "./$(basename "${file%.rs}")") ;;
*\.sh) dash "$file" ;;
*\.smt2) z3 "$file" ;;
*\.tex)
    textype "$file" || exit 1
    # Clean only successful TeX builds, including glossary processing.
    if [ "$clear_tex" -eq 1 ]; then
        texclear "$file"
    fi
    ;;
*\.vpr) $vipercmd "$file" ;;
*\.zsh) zsh "$file" ;;
*\.ly) lilypond "$file" ;;
*) sed 1q "$file" | grep "^#!/" | sed "s/^#!//" | xargs -r -I % "$file" ;;
esac
